{
  "name": "dejabug",
  "displayName": "DejaBug",
  "description": "Detect potential code bugs patterns and it warns that you're going back to these",
  "version": "0.0.1",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dejabug.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "dejabug.markUseful",
        "title": "DejaBug: Mark as Useful"
      },
      {
        "command": "dejabug.markNotRelevant",
        "title": "DejaBug: Mark as Not Relevant"
      },
      {
        "command": "dejabug.createSnapshotFromSelection",
        "title": "DejaBug: Create Snapshot from Selection"
      },
      {
        "command": "dejabug.listSnapshots",
        "title": "DejaBug: View All Snapshots"
      },
      {
        "command": "dejabug.setGithubToken",
        "title": "DejaBug: Set GitHub Token"
      },
      {
        "command": "dejabug.setGitlabToken",
        "title": "DejaBug: Set GitLab Token"
      },
      {
        "command": "dejabug.findDuplicateSnapshots",
        "title": "DejaBug: Find Duplicate Snapshots"
      },
      {
        "command": "dejabug.showTeamPatterns",
        "title": "DejaBug: Show Team Patterns"
      }
    ],
    "configuration": {
      "title": "DejaBug",
      "properties": {
        "dejabug.semanticThreshold": {
          "type": "number",
          "default": 0.86,
          "minimum": 0,
          "maximum": 1,
          "description": "Cosine similarity threshold for semantic (embedding-based) ghost matches. Tuned automatically over time by the feedback loop, but can be overridden by hand."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "simple-git": "^3.36.0"
  }
}
